# Supabase Environment Variables for personal-portal
# Copy this file to .env and replace with your actual Supabase credentials

VITE_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare Turnstile (CAPTCHA) public site key for login/signup forms.
# Leave empty to disable the widget (graceful degrade).
# NOTE: The matching Turnstile secret key belongs ONLY in the Supabase Auth
# configuration (Dashboard -> Authentication -> Attack Protection -> CAPTCHA),
# never in client-side environment variables.
VITE_TURNSTILE_SITE_KEY=
